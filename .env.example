# Copy to .env.local (never commit .env.local).
# Browser-safe values ONLY. NEVER put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# OPTIONAL public guest demo account (shown on the login page). These values are PUBLIC in the browser bundle:
# use a throw-away account that only has read-only demo access (see supabase/setup_guest.sql). Leave empty to hide the box.
VITE_GUEST_EMAIL=
VITE_GUEST_PASSWORD=
